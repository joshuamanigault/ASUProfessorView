{
    "manifest_version": 3,
    "name": "ASU ProfessorView",
    "version": "1.3.3",
    "description": "Rate My Professor Plugin for ASU Class Search. See professor ratings directly in ASU Class Search.",
    "author": "n.joshuamanigault@gmail.com",
    "homepage_url": "https://github.com/joshuamanigault/ASUProfessorView",
    "permissions": [
        "storage",
        "alarms"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "options_page": "options.html",
    "host_permissions": [
        "https://*.ratemyprofessors.com/*",
        "https://catalog.apps.asu.edu/*"
    ],
    "background": {
        "scripts": ["background.js"],
        "type": "module"
    },
    "browser_specific_settings": {  
        "gecko": {
            "id": "asu-professorview@joshuamanigault.com",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["none"],
                "optional": []
            }
        }
    },
    "content_scripts": [
        {
            "matches": ["https://catalog.apps.asu.edu/*"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    }
}