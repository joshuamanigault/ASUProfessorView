{
  "name": "asu_professor_view",
  "private": true,
  "version": "1.3.4",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npx tsx src/rmp-api.ts",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "cross-env BUILD_TARGET=chrome vite build",
    "build:firefox": "cross-env BUILD_TARGET=firefox vite build",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "validate:extensions": "node scripts/validate-extension.mjs",
    "lint:firefox": "addons-linter dist-firefox --boring",
    "smoke:content": "node scripts/smoke-content.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run validate:extensions && npm run smoke:content && npm run lint:firefox",
    "package": "npm run check && node scripts/package-extension.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.12",
    "@types/node": "^24.5.2",
    "addons-linter": "^10.13.0",
    "cross-env": "^10.1.0",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "es-toolkit": "^1.45.1",
    "rate-my-professor-api-ts": "^1.0.5"
  }
}
